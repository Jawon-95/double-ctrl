<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Double Ctrl" Width="344" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="Transparent" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="Transparent" CornerRadius="5" Padding="6,3">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ReadOnlyText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="ContextMenu" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Outline}" CornerRadius="3"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <!-- 第 0 行是预留的透明区域：标题栏隐藏时这里完全透明且可穿透点击，
       悬停时卡片向上长出标题栏，窗口本身不移动，内容也不会跳动。 -->
  <Grid x:Name="Root" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border x:Name="Card" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="14">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="{DynamicResource ShadowOpacity}"/>
      </Border.Effect>
    </Border>
    <!-- 整行都是拖动区域，内边距放在里层，否则贴近边框的地方拖不动。 -->
    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Visibility="Hidden">
      <DockPanel Margin="14,10,10,4">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="固定窗口"/>
          <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="更多">
            <TextBlock Text="&#xE712;" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform Angle="90"/>
              </TextBlock.RenderTransform>
            </TextBlock>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="&#xE8BB;" FontSize="11" ToolTip="关闭"/>
        </StackPanel>
        <Image x:Name="AppIcon" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Double Ctrl" Foreground="{DynamicResource Text}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
        <Button x:Name="LangButton" Style="{StaticResource TextButton}" Margin="6,0,0,0" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="LangText" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="8" Margin="4,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </DockPanel>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,6,0,0">
      <DockPanel Margin="16,8,12,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,2,0,0">
          <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="清空" Visibility="Hidden"/>
          <Button x:Name="SearchButton" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="查询"/>
        </StackPanel>
        <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Padding="0,1"
                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Accent}" SelectionBrush="{DynamicResource Accent}"
                 FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="92" VerticalScrollBarVisibility="Auto"
                 MaxLength="5000"/>
      </DockPanel>
      <Border Height="1" Margin="16,6,16,0" Background="{DynamicResource Outline}"/>

      <ScrollViewer x:Name="Scroller" MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="16,8,8,0" Focusable="False">
        <StackPanel x:Name="Results" Margin="0,0,8,0"/>
      </ScrollViewer>

      <Button x:Name="MoreLink" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,2,10,8" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="更多释义"/>
          <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="4,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Border x:Name="BottomGap" Height="12"/>
    </StackPanel>
  </Grid>
</Window>
